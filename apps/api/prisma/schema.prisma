generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CUSTOMER
  OWNER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VenueStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ConfirmationMode {
  INSTANT
  OWNER_APPROVAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum ActorType {
  USER
  SYSTEM
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  email                String                 @unique
  phone                String
  displayName          String                 @map("display_name")
  passwordHash         String                 @map("password_hash")
  avatarObjectKey      String?                @map("avatar_object_key")
  avatarUpdatedAt      DateTime?              @map("avatar_updated_at") @db.Timestamptz(3)
  isLocked             Boolean                @default(false) @map("is_locked")
  securityVersion      Int                    @default(1) @map("security_version")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                UserRole[]
  refreshSessions      RefreshSession[]
  ownerApplications    OwnerApplication[]     @relation("OwnerApplicant")
  reviewedApplications OwnerApplication[]     @relation("OwnerApplicationReviewer")
  venues               Venue[]
  bookings             Booking[]
  bookingStatusChanges BookingStatusHistory[]
  notifications        Notification[]
  idempotencyRecords   IdempotencyRecord[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_sessions")
}

model OwnerApplication {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  businessName String       @map("business_name")
  experience   String?
  status       ReviewStatus @default(PENDING)
  reviewReason String?      @map("review_reason")
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User         @relation("OwnerApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("OwnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("owner_applications")
}

model Area {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  type     String
  parentId String? @map("parent_id") @db.Uuid
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Area[]  @relation("AreaHierarchy")
  venues   Venue[]

  @@index([parentId])
  @@map("areas")
}

model Venue {
  id               String               @id @default(uuid()) @db.Uuid
  ownerId          String               @map("owner_id") @db.Uuid
  areaId           String               @map("area_id") @db.Uuid
  name             String
  address          String
  description      String
  latitude         Decimal              @db.Decimal(9, 6)
  longitude        Decimal              @db.Decimal(9, 6)
  status           VenueStatus          @default(DRAFT)
  moderationReason String?              @map("moderation_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  area             Area                 @relation(fields: [areaId], references: [id], onDelete: Restrict)
  images           VenueImage[]
  amenities        VenueAmenity[]
  offerings        VenueSportOffering[]
  operatingHours   OperatingHour[]
  closures         VenueClosure[]

  @@index([ownerId, status])
  @@index([areaId, status])
  @@map("venues")
}

model VenueImage {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  objectKey String   @map("object_key")
  url       String
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, objectKey])
  @@map("venue_images")
}

model Amenity {
  id     String         @id @default(uuid()) @db.Uuid
  code   String         @unique
  name   String
  venues VenueAmenity[]

  @@map("amenities")
}

model VenueAmenity {
  venueId   String  @map("venue_id") @db.Uuid
  amenityId String  @map("amenity_id") @db.Uuid
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([venueId, amenityId])
  @@index([amenityId])
  @@map("venue_amenities")
}

model Sport {
  id        String               @id @default(uuid()) @db.Uuid
  code      String               @unique
  name      String
  isActive  Boolean              @default(true) @map("is_active")
  offerings VenueSportOffering[]

  @@map("sports")
}

model VenueSportOffering {
  id                        String           @id @default(uuid()) @db.Uuid
  venueId                   String           @map("venue_id") @db.Uuid
  sportId                   String           @map("sport_id") @db.Uuid
  confirmationMode          ConfirmationMode @default(INSTANT) @map("confirmation_mode")
  advanceBookingDays        Int              @default(14) @map("advance_booking_days")
  cancellationNoticeMinutes Int              @default(120) @map("cancellation_notice_minutes")
  isActive                  Boolean          @default(true) @map("is_active")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  venue                     Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  sport                     Sport            @relation(fields: [sportId], references: [id], onDelete: Restrict)
  courts                    Court[]
  pricingRules              PricingRule[]
  bookings                  Booking[]

  @@unique([venueId, sportId])
  @@index([sportId, isActive])
  @@map("venue_sport_offerings")
}

model Court {
  id           String             @id @default(uuid()) @db.Uuid
  offeringId   String             @map("offering_id") @db.Uuid
  internalName String             @map("internal_name")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  offering     VenueSportOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  closures     VenueClosure[]
  bookings     Booking[]

  @@unique([offeringId, internalName])
  @@unique([id, offeringId])
  @@map("courts")
}

model OperatingHour {
  id          String @id @default(uuid()) @db.Uuid
  venueId     String @map("venue_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")
  venue       Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, weekday])
  @@map("operating_hours")
}

model VenueClosure {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  courtId   String?  @map("court_id") @db.Uuid
  startAt   DateTime @map("start_at") @db.Timestamptz(3)
  endAt     DateTime @map("end_at") @db.Timestamptz(3)
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([venueId, startAt, endAt])
  @@index([courtId, startAt, endAt])
  @@map("venue_closures")
}

model PricingRule {
  id           String             @id @default(uuid()) @db.Uuid
  offeringId   String             @map("offering_id") @db.Uuid
  weekday      Int
  startMinute  Int                @map("start_minute")
  endMinute    Int                @map("end_minute")
  pricePerSlot BigInt             @map("price_per_slot")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  offering     VenueSportOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, weekday])
  @@map("pricing_rules")
}

model Booking {
  id                        String                 @id @default(uuid()) @db.Uuid
  customerId                String                 @map("customer_id") @db.Uuid
  offeringId                String                 @map("offering_id") @db.Uuid
  courtId                   String                 @map("court_id") @db.Uuid
  startAt                   DateTime               @map("start_at") @db.Timestamptz(3)
  endAt                     DateTime               @map("end_at") @db.Timestamptz(3)
  status                    BookingStatus
  expiresAt                 DateTime?              @map("expires_at") @db.Timestamptz(3)
  occupiesCourt             Boolean                @map("occupies_court")
  priceAmount               BigInt                 @map("price_amount")
  currency                  String                 @default("VND")
  slotMinutes               Int                    @default(30) @map("slot_minutes")
  cancellationNoticeMinutes Int                    @map("cancellation_notice_minutes")
  confirmationModeSnapshot  ConfirmationMode       @map("confirmation_mode_snapshot")
  pricingBreakdown          Json                   @map("pricing_breakdown")
  cancellationReason        String?                @map("cancellation_reason")
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer                  User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  offering                  VenueSportOffering     @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  court                     Court                  @relation(fields: [courtId, offeringId], references: [id, offeringId], onDelete: Restrict)
  history                   BookingStatusHistory[]

  @@index([customerId, startAt])
  @@index([offeringId, startAt, endAt])
  @@index([courtId, startAt, endAt])
  @@index([status, expiresAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorType  ActorType      @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  type           String
  payload        Json
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  emailStatus    EmailDeliveryStatus @default(PENDING) @map("email_status")
  emailAttempts  Int                 @default(0) @map("email_attempts")
  emailLastError String?             @map("email_last_error")
  emailSentAt    DateTime?           @map("email_sent_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  resourceId     String?  @map("resource_id") @db.Uuid
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, scope, key])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([dispatchedAt, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId       String   @map("event_id") @db.Uuid
  processorName String   @map("processor_name")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, processorName])
  @@map("processed_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
