{
  "name": "@sports-booking/api",
  "private": true,
  "version": "0.1.0",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "jest --runInBand --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "db:generate": "prisma generate",
    "db:validate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db seed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p prisma/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.12.0",
    "@aws-sdk/client-s3": "3.1128.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "prisma": "6.12.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
