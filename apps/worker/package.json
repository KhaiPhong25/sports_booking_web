{
  "name": "@sports-booking/worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prebuild": "npm run build -w @sports-booking/shared",
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run build -w @sports-booking/shared",
